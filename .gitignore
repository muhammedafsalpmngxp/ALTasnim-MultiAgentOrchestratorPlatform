# ---- secrets / local config (NEVER commit) ---------------------------
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# ---- Python ----------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
*.egg
.venv/
venv/
env/
.python-version
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.tox/
.nox/
.cache/

# ---- LangGraph -------------------------------------------------------
.langgraph_api/

# ---- local databases / vector stores ------------------------------------
qdrant_storage/
*.sqlite3
*.db

# ---- supervisor: agent planning text customised in the admin console (per machine) ----
backend/superviser-agent/data/

# ---- Node / Angular --------------------------------------------------
node_modules/
.angular/
.nx/
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---- logs / temp -----------------------------------------------------
*.log
logs/
tmp/
*.tmp

# ---- OS / editors ----------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
.idea/
*.swp
/.vscode/
