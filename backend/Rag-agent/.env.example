# Copy to .env to change settings (all optional; these are the defaults).
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=rag_chunks
EMBEDDING_MODEL=BAAI/bge-m3
RERANK_MODEL=BAAI/bge-reranker-v2-m3
# Chunk size in words, and words shared between consecutive chunks
CHUNK_WORDS=300
CHUNK_OVERLAP_WORDS=50
# Hits taken from each search (sparse and dense), fused, then reranked
CANDIDATES=20
# Chunks returned by /retrieve when the request has no top_k
TOP_K=5
MAX_UPLOAD_MB=50
# Next agents: /retrieve POSTs {"question": ..., "chunks": [...]} to each PORT/PATH (comma-separated),
# e.g. NEXT_AGENTS=8203/synthesize, 8210/answer. For each, the machine in NEXT_AGENT_SUBNET with the port
# open that serves the path is found automatically. Empty = don't pass on.
# Outside Docker, an empty subnet means "this machine's own /24".
NEXT_AGENTS=
NEXT_AGENT_SUBNET=
NEXT_AGENT_TIMEOUT=120
