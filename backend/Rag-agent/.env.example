# Copy to .env to change settings (all optional; these are the defaults).
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=rag_chunks
EMBEDDING_MODEL=BAAI/bge-m3
RERANK_MODEL=BAAI/bge-reranker-v2-m3
# Chunk size in words, and words shared between consecutive chunks
CHUNK_WORDS=300
CHUNK_OVERLAP_WORDS=50
# Hits taken from each search (sparse and dense), fused, then reranked
CANDIDATES=20
# Chunks returned by /retrieve when the request has no top_k
TOP_K=5
MAX_UPLOAD_MB=50
