# ─────────────────────────────────────────────────────────────────────────────
# L&T Files Assistant — Environment Configuration
# Copy this file to .env and fill in your values.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────────────────────
APP_NAME=L&T Files Assistant
APP_VERSION=1.0.0
APP_ENV=development          # development | production
DEBUG=true
PORT=8000

# CORS — frontend dev server origin (comma-separated for multiple)
CORS_ORIGINS=http://localhost:5173

# ── Authentication ────────────────────────────────────────────────────────────
# Default admin credentials (used when DB is not configured)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin@123

# JWT settings — CHANGE THIS TO A RANDOM 64-char SECRET IN PRODUCTION
JWT_SECRET_KEY=change_me_to_a_random_secret_key_at_least_64_chars_long_for_security
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440      # 24 hours

# ── Database ──────────────────────────────────────────────────────────────────
# Use LT_DB_TYPE (not DB_TYPE) — avoids colliding with RAGFlow's internal DB_TYPE variable.
# LT_DB_TYPE: sqlite | mysql | postgresql
LT_DB_TYPE=sqlite
DB_PATH=./data/lt_assistant.db

# MySQL / PostgreSQL (only used when DB_TYPE is not sqlite)
# DB_TYPE=mysql
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=lt_assistant
# DB_USER=root
# DB_PASSWORD=your_db_password

# ── LLM Provider ─────────────────────────────────────────────────────────────
# LLM_PROVIDER is the DEFAULT chat model (router + agent + RAG).
# LLM_PROVIDER: local | openai | groq | gemini
# Admins can switch between configured providers at runtime from the top bar of the app (no
# restart). That choice is saved in the database and overrides this value until it is reset.
LLM_PROVIDER=local

# Ollama (local, GPU) — requires Ollama running on the host (auto-starts in background).
# In Docker, docker-compose.prod.yml overrides OLLAMA_BASE_URL to http://host.docker.internal:11434.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.6:35b-a3b
# Keep the model resident on the GPU after each request so chats don't cold-start.
# Values: duration ("1h", "30m"), seconds ("3600"), or "-1" (never unload). Blank = Ollama's 5m default.
OLLAMA_KEEP_ALIVE=1h

# OpenAI — set OPENAI_API_KEY to make OpenAI selectable in the admin switch.
# Note: with OpenAI active, questions and the retrieved document excerpts are sent to OpenAI's API.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Groq
# LLM_PROVIDER=groq
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=AIza...
# GEMINI_MODEL=gemini-1.5-flash

# ── Embedding & Rerank ────────────────────────────────────────────────────────
# EMBEDDING_PROVIDER / RERANK_PROVIDER: bge = BAAI/bge-* running in-process on the GPU (LocalHF,
# free) | openai (embedding only, paid). NOTE: "bge" runs locally on the GPU — it is NOT an API.
# WARNING: changing EMBEDDING_PROVIDER after documents are indexed requires re-parsing them.
EMBEDDING_PROVIDER=bge
BGE_EMBEDDING_MODEL=BAAI/bge-m3
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

RERANK_PROVIDER=bge
BGE_RERANK_MODEL=BAAI/bge-reranker-v2-m3
# Enable reranking inside the analysis agent (fast now that it runs on the GPU).
AGENT_RERANK=1

# ── Document Engine (Elasticsearch) ──────────────────────────────────────────
DOC_ENGINE=elasticsearch
ES_HOST=http://localhost:9200
# ES_USER=elastic
# ES_PASSWORD=

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
# REDIS_PASSWORD=

# ── Storage ───────────────────────────────────────────────────────────────────
STORAGE_TYPE=local           # local | minio  (field name must match config.py: STORAGE_TYPE)
STORAGE_PATH=./data/uploads

# MinIO (only when STORAGE_BACKEND=minio)
# MINIO_ENDPOINT=localhost:9000
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=minioadmin
# MINIO_BUCKET=lt-assistant

# ── File Processing ───────────────────────────────────────────────────────────
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_SIZE_MB=200        # field name must match config.py: MAX_UPLOAD_SIZE_MB
# Extensions supported (comma-separated, DWG/DXF auto-convert to PDF)
SUPPORTED_EXTENSIONS=.pdf,.docx,.doc,.xlsx,.xls,.pptx,.ppt,.txt,.md,.csv,.html,.png,.jpg,.jpeg,.dwg,.dxf

# DeepDoc microservice (PDF layout analysis, OCR, table structure recognition)
DEEPDOC_URL=http://localhost:8124
