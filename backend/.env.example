# ONE env file for ALL agents. Template: .env.example (committed). Real file: .env (never committed).
#   cd backend
#   copy .env.example .env
#
# Every agent section has the same layout:
#   INPUT     the port it listens on (and its routes)
#   OUTPUT    where it sends its result (port + path)
#   SETTINGS  everything else
#
# Read by every agent (utils.env / python-dotenv), by backend/docker-compose.yml (ports + every container) and
# by backend/rag_agent/docker-compose.yml (docker compose --env-file ../.env up). Never copied into an image;
# tests never read it. Real environment variables always win. Defaults run offline: no live search, no LLM,
# nothing sent to other machines.

# ==================================================================== shared (every agent)
AUTH_MODE=dev
# OpenAI: ONE key for every agent. The WEB_SEARCH_ and SYNTHESIZER_ keys below use it (${OPENAI_API_KEY});
# put another key there to override. LangGraph agents use it when LLM_MODEL_* is openai:<model>.
OPENAI_API_KEY=
# OPENAI_BASE_URL=
# (only for a gateway / OpenAI-compatible server; never leave it set but empty)
# Shared LLM tiers for agents that use utils/llm.py (the verifier), format <provider>:<model>, e.g. openai:gpt-4o-mini.
# The supervisor has its own model (SUPERVISOR_LLM_MODEL, section superviser_agent).
# LLM_MODEL_STANDARD=
# LLM_MODEL_FAST=
# Tracing (optional)
# LANGSMITH_API_KEY=
# LANGSMITH_TRACING=true
# LANGSMITH_PROJECT=altasnim-agents

# ==================================================================== web_search_agent
# INPUT     LangGraph API (/threads, /runs), POST /custom/search/stream, POST /custom/retry, GET /custom/history
WEB_SEARCH_PORT=8201
# OUTPUT    question + top contents -> POST each path on every machine in the network with the port open
WEB_SEARCH_VERIFIER_PORT=8203
WEB_SEARCH_VERIFIER_PATH=
# (path e.g. /verify,/synthesize; empty = send nothing. Port can be a list: 8203,8230)
WEB_SEARCH_VERIFIER_TIMEOUT_SECONDS=120
# WEB_SEARCH_VERIFIER_TOKEN=
# WEB_SEARCH_DISCOVERY_SUBNETS=
# (networks to search; default: this machine's network. In Docker set your LAN, e.g. 192.168.1.0/24)
# SETTINGS  all keys: web_search_agent/src/web_search_agent/settings.py
# Search providers, tried left to right: google,tavily,searxng,duckduckgo = live web | sample = offline data
WEB_SEARCH_PROVIDERS=sample
WEB_SEARCH_GOOGLE_API_KEY=
WEB_SEARCH_GOOGLE_CSE_ID=
WEB_SEARCH_TAVILY_API_KEY=
WEB_SEARCH_SEARXNG_URL=
WEB_SEARCH_ALWAYS_PROVIDERS=wikipedia
WEB_SEARCH_SEARCH_RESULTS_PER_QUERY=5
WEB_SEARCH_MAX_TOTAL_RESULTS=8
WEB_SEARCH_RESULT_TOP_N=3
# LLM for query planning only (empty key = the question is searched as-is)
WEB_SEARCH_OPENAI_API_KEY=${OPENAI_API_KEY}
# WEB_SEARCH_OPENAI_BASE_URL=
WEB_SEARCH_OPENAI_FAST_MODEL=gpt-4o-mini
WEB_SEARCH_MAX_SEARCH_QUERIES=3
# Page fetching
WEB_SEARCH_MAX_PAGES_TO_FETCH=4
WEB_SEARCH_PAGE_DEADLINE_SECONDS=8
WEB_SEARCH_RESPECT_ROBOTS_TXT=true
WEB_SEARCH_USE_PLAYWRIGHT_FALLBACK=false
# Reranker: cross-encoder/ms-marco-MiniLM-L-6-v2 (fast, CPU) | BAAI/bge-reranker-base | BAAI/bge-reranker-v2-m3 (GPU)
WEB_SEARCH_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
WEB_SEARCH_RECENCY_WEIGHT=0.1
WEB_SEARCH_TRUSTED_BOOST=0.15
# WEB_SEARCH_BLOCKED_DOMAINS=facebook.com,instagram.com,tiktok.com,x.com,twitter.com,youtube.com
# WEB_SEARCH_TRUSTED_DOMAINS=wikipedia.org,britannica.com,reuters.com,gov,edu
# WEB_SEARCH_CHECKPOINT_DIR=
# WEB_SEARCH_CHECKPOINT_KEEP=200
# WEB_SEARCH_CHUNK_SIZE_WORDS=220
# WEB_SEARCH_CHUNK_OVERLAP_WORDS=40

# ==================================================================== communication_agent
# INPUT     plan step from the supervisor: {"task": {objective, params: {to, cc?, subject?, recipient_name?, tone?,
#           language?, instructions?}, inputs: outputs of the earlier steps}}; GET /card, /custom/status, /custom/sent
COMMUNICATION_PORT=8202
# LLM       writes a professional email from the earlier steps' results only (every number / link checked);
#           key: OPENAI_API_KEY. Empty = plain template.
COMMUNICATION_LLM_MODEL=gpt-4o-mini
# OUTPUT    email after a human approves it: smtp = send | console = log only (testing)
#           Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USE_TLS=true, SMTP_PASSWORD = an App Password
#           (Google Account -> Security -> 2-Step Verification -> App passwords), never the Gmail password.
#           Mailpit (local test inbox, docker compose --profile mail up): SMTP_HOST=mailpit, SMTP_PORT=1025,
#           SMTP_USE_TLS=false, no username / password; open http://localhost:8025
EMAIL_DELIVERY=console
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
# SETTINGS  sender name and signature (\n = new line); EMAIL_FROM defaults to SMTP_USERNAME
EMAIL_FROM_NAME=ALTasnim Agent Platform
# EMAIL_SIGNATURE=Best regards,\nALTasnim Agent Platform
# EMAIL_FROM=
# EMAIL_REPLY_TO=
# EMAIL_ALLOWED_DOMAINS=
# (recipients' domains allowed, comma separated; empty = any)
EMAIL_MAX_RECIPIENTS=10

# ==================================================================== verifier_agent
# INPUT     POST /verify (any JSON), LangGraph API (/threads, /runs), GET /ui, GET /verify/calls
VERIFIER_PORT=8203
# OUTPUT    verdict -> the reply to the caller, and (POST /verify only) {question, verification, inputs} -> synthesizer:
#           sent to the machine in the network that has VERIFIER_SYNTHESIZER_PORT open and serves the path
#           (this machine is skipped). Found automatically; cached until it stops answering.
VERIFIER_SYNTHESIZER_PORT=8204
VERIFIER_SYNTHESIZER_PATH=
# (e.g. /synthesize; empty = send nothing)
# VERIFIER_DISCOVERY_SUBNETS=
# (networks to search; default: this machine's network, e.g. 192.168.1.0/24)
VERIFIER_SYNTHESIZER_URL=
# (a full URL, e.g. http://192.168.1.22:8204/synthesize, skips the search; empty = search)
VERIFIER_SYNTHESIZER_TIMEOUT_SECONDS=120
# SETTINGS  LLM that checks the question against the content: verified / not verified (empty = LLM_MODEL_STANDARD;
# neither set = check skipped with a warning). Format <provider>:<model>, openai uses OPENAI_API_KEY.
VERIFIER_LLM_MODEL=

# ==================================================================== synthesizer_agent
# INPUT     POST /synthesize (any JSON: question + inputs/chunks), GET /runs
SYNTHESIZER_HOST=0.0.0.0
SYNTHESIZER_PORT=8204
# (keep 8204: run.py's code default is 8203, the verifier's port)
# SYNTHESIZER_CORS_ORIGINS=http://localhost:4200,http://localhost:4304
# OUTPUT    the answer is the reply to the caller; written by the LLM at (empty key = inputs' summaries):
# SYNTHESIZER_OPENAI_BASE_URL=
# (OpenAI-compatible server, e.g. Ollama http://localhost:11434/v1 - then no key needed)
SYNTHESIZER_OPENAI_API_KEY=${OPENAI_API_KEY}
SYNTHESIZER_OPENAI_MODEL=gpt-4o-mini
# SETTINGS
SYNTHESIZER_RELOAD=true
SYNTHESIZER_MAX_RUNS=50

# ==================================================================== rag_agent
# INPUT     POST /retrieve {question}, POST /documents (upload), GET /documents, GET /documents/{id}/chunks
RAG_PORT=8000
# OUTPUT    {question, chunks} -> POST each PORT/PATH on the machine in the subnet that serves it
RAG_NEXT_AGENTS=
# (e.g. 8203/verify, 8204/synthesize; empty = don't pass on)
RAG_NEXT_AGENT_SUBNET=
# (network to search; in Docker it must be set, e.g. 192.168.1.0/24)
RAG_NEXT_AGENT_TIMEOUT=120
# SETTINGS
# What the documents cover (the supervisor reads it to send these topics to the documents, not the web), e.g.
# RAG_DOMAIN=well construction and drilling operations, drilling rigs, company business rules and processes
RAG_DOMAIN=
RAG_QDRANT_URL=http://localhost:6333
# (Docker: rag_agent/docker-compose.yml sets http://qdrant:6333)
RAG_QDRANT_COLLECTION=rag_chunks
RAG_EMBEDDING_MODEL=BAAI/bge-m3
RAG_RERANK_MODEL=BAAI/bge-reranker-v2-m3
RAG_CHUNK_WORDS=300
RAG_CHUNK_OVERLAP_WORDS=50
RAG_CANDIDATES=20
RAG_TOP_K=5
RAG_MAX_UPLOAD_MB=50

# ==================================================================== superviser_agent (orchestrator, entry point)
# Last on purpose: its OUTPUT reuses the ports of the agents above.
# INPUT     LangGraph API (/threads, /runs; assistant "orchestrator"), GET /platform/agents, /platform/policies
ORCHESTRATOR_PORT=8100
# OUTPUT    plan steps -> every agent node: each agent is a LangGraph deployment on its PORT (graph ids in
#           superviser_agent/config/agents.dev.yaml); the machine serving it is found on the network, so no IPs.
#           The supervisor's LLM plans the flow per question, e.g. rag | web_search -> verifier -> synthesizer
AGENT_WEB_SEARCH=${WEB_SEARCH_PORT}
AGENT_RAG=${RAG_PORT}
AGENT_VERIFIER=${VERIFIER_PORT}
AGENT_SYNTHESIZER=${SYNTHESIZER_PORT}
AGENT_COMMUNICATION=${COMMUNICATION_PORT}
AGENT_SUBNET=
# (networks to search, e.g. 192.168.1.0/24; empty = this machine's own /24. In Docker set your LAN)
# AGENT_LOCAL_HOSTS=localhost,host.docker.internal
# (this machine, searched first: an agent running here wins over the same agent on a teammate's machine)
# AGENT_RAG_URL=http://192.168.1.33:8000
# (pins one agent's machine and skips the search; works for every AGENT_<NAME>_URL)
# LLM       the supervisor thinks with its own model: it reads the request and the agent cards and plans the flow.
#           <provider>:<model> (a bare name = openai:<name>; key: OPENAI_API_KEY). Required: without it the
#           supervisor answers that it is not configured.
SUPERVISOR_LLM_MODEL=openai:gpt-4o
# (optional below: temperature empty for reasoning models, gpt-5.x reject it; reasoning effort low | medium | high,
#  reasoning models only; Responses API true for openai, needed by gpt-5.x for tools, false = Chat Completions)
# SUPERVISOR_LLM_TEMPERATURE=0
# SUPERVISOR_LLM_REASONING_EFFORT=low
# SUPERVISOR_LLM_TIMEOUT_SECONDS=60
# SUPERVISOR_LLM_MAX_RETRIES=2
# SUPERVISOR_LLM_RESPONSES_API=true
# SETTINGS  local = run agent graphs in-process | remote = call every agent on its port
AGENT_TRANSPORT=remote
AGENTS_CONFIG=config/agents.dev.yaml
POLICIES_CONFIG=config/policies.yaml
# AGENT_OVERRIDES_FILE=data/agent_overrides.yaml
# (planning text customised in the admin console; a volume in Docker)
# ORCHESTRATOR_SERVICE_TOKEN=
