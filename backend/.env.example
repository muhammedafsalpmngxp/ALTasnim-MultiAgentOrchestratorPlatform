# ONE env file for all agents. Copy to backend/.env (never commit .env).
# Local runs load it automatically (utils.env). docker-compose passes it to every container.
# Real environment variables always override this file.

# ------------------------------------------------------------------ shared
AUTH_MODE=dev

# LLMs, format <provider>:<model> (openai, azure_openai, anthropic, google_genai, bedrock, ollama, ...).
# Install the provider package too (e.g. pip install langchain-openai).
# Without them, every agent uses its rule-based fallback (fully offline).
# LLM_MODEL_STRONG=      # supervisor planning
# LLM_MODEL_STANDARD=    # drafting, checks
# LLM_MODEL_FAST=        # query planning

# Tracing (optional)
# LANGSMITH_API_KEY=
# LANGSMITH_TRACING=true
# LANGSMITH_PROJECT=altasnim-agents

# ------------------------------------------------------------------ orchestrator-agent (:8100)
# local  = run agent graphs in-process (no agent servers needed)
# remote = call each agent deployment over HTTP (8201-8203)
AGENT_TRANSPORT=remote
AGENTS_CONFIG=config/agents.dev.yaml
POLICIES_CONFIG=config/policies.yaml
# ORCHESTRATOR_SERVICE_TOKEN=
# Override agent URLs from config/agents.dev.yaml (docker-compose sets these):
# AGENT_WEB_SEARCH_URL=http://localhost:8201
# AGENT_COMMUNICATION_URL=http://localhost:8202
# AGENT_VERIFIER_URL=http://localhost:8203

# ------------------------------------------------------------------ web-search-agent (:8201)
# Every web-search-agent key starts with WEB_SEARCH_ (see web_search_agent/src/web_search_agent/settings.py).
# Search providers, tried left to right (unconfigured ones are skipped):
#   sample                    = offline placeholder data, no network (default; CI and tests)
#   tavily,searxng,duckduckgo = live web
WEB_SEARCH_PROVIDERS=sample
# Free key: https://app.tavily.com
# WEB_SEARCH_TAVILY_API_KEY=
# Self-hosted SearXNG, e.g. http://localhost:8080 (enable "json" in search.formats)
# WEB_SEARCH_SEARXNG_URL=
# OpenAI for query planning. Empty = the question is searched as-is.
# WEB_SEARCH_OPENAI_API_KEY=
# WEB_SEARCH_OPENAI_BASE_URL=
# WEB_SEARCH_OPENAI_FAST_MODEL=gpt-4o-mini
# WEB_SEARCH_MAX_SEARCH_QUERIES=3
# Contents sent to the verifier
# WEB_SEARCH_RESULT_TOP_N=3
# WEB_SEARCH_MAX_PAGES_TO_FETCH=6
# WEB_SEARCH_PAGE_DEADLINE_SECONDS=8
# WEB_SEARCH_RESPECT_ROBOTS_TXT=true
# WEB_SEARCH_USE_PLAYWRIGHT_FALLBACK=false
# BAAI/bge-reranker-base (default) | BAAI/bge-reranker-v2-m3 (best, GPU) | cross-encoder/ms-marco-MiniLM-L-6-v2 (fast)
# WEB_SEARCH_RERANKER_MODEL=BAAI/bge-reranker-base
# WEB_SEARCH_RECENCY_WEIGHT=0.1
# Send the output (question + top 3 contents) to these POST routes on every machine of the network that has them
# WEB_SEARCH_VERIFIER_PATH=/verify,/synthesize
# WEB_SEARCH_VERIFIER_PORT=8203
# WEB_SEARCH_DISCOVERY_SUBNETS=192.168.1.0/24

# ------------------------------------------------------------------ communication-agent (:8202)
# console = print only | smtp = send (Mailpit: docker compose --profile mail up)
EMAIL_CHANNEL=console
EMAIL_SMTP_HOST=localhost
EMAIL_SMTP_PORT=1025
EMAIL_FROM=agents@altasnim.local
