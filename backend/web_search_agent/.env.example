# web-search-agent's own settings. Copy to backend/web_search_agent/.env (never commit .env).
#
# Read by src/web_search_agent/settings.py. Priority: real environment variables > this file > backend/.env.
# Every key starts with WEB_SEARCH_. Not loaded under pytest (tests stay offline).

# ------------------------------------------------------------------ search providers
# Tried left to right until one returns results (unconfigured ones are skipped):
#   google,tavily,searxng,duckduckgo = live web | sample = offline placeholder data
WEB_SEARCH_PROVIDERS=google,tavily,duckduckgo
# Google Programmable Search (free, 100 searches/day): an API key + a search engine id set to "search the entire web"
#   key: https://developers.google.com/custom-search/v1/introduction   engine: https://programmablesearchengine.google.com
WEB_SEARCH_GOOGLE_API_KEY=
WEB_SEARCH_GOOGLE_CSE_ID=
# Free key: https://app.tavily.com
WEB_SEARCH_TAVILY_API_KEY=
# Self-hosted SearXNG, e.g. http://localhost:8080 (enable "json" in search.formats)
WEB_SEARCH_SEARXNG_URL=
# Also searched on every query and merged in (the 2 best articles): wikipedia | empty = off
WEB_SEARCH_ALWAYS_PROVIDERS=wikipedia
# Never used as sources (default: facebook, instagram, tiktok, x/twitter, youtube, pinterest, linkedin, reddit, quora,
# threads, snapchat). Preferred sources are ranked higher and read first (default: wikipedia, britannica, reuters, apnews,
# bbc, who.int, un.org + any government "gov" / university "edu" site):
# WEB_SEARCH_BLOCKED_DOMAINS=facebook.com,instagram.com,tiktok.com,x.com,twitter.com,youtube.com
# WEB_SEARCH_TRUSTED_DOMAINS=wikipedia.org,britannica.com,reuters.com,gov,edu
# Results per query / in total after merging the queries
WEB_SEARCH_SEARCH_RESULTS_PER_QUERY=5
WEB_SEARCH_MAX_TOTAL_RESULTS=8

# ------------------------------------------------------------------ LLM (query planning only)
# Empty = the question is searched as-is.
WEB_SEARCH_OPENAI_API_KEY=
# WEB_SEARCH_OPENAI_BASE_URL=
WEB_SEARCH_OPENAI_FAST_MODEL=gpt-4o-mini
WEB_SEARCH_MAX_SEARCH_QUERIES=3

# ------------------------------------------------------------------ output -> other agents on the network
# Contents sent with the question
WEB_SEARCH_RESULT_TOP_N=3
# The POST routes to send the output to. Every machine of the network that has one of them on the port below gets
# it (one POST per route found), e.g. the verifier's /verify and the synthesizer's /synthesize. Empty = none.
WEB_SEARCH_VERIFIER_PATH=/verify,/synthesize
# one port or several: 8203,8230
WEB_SEARCH_VERIFIER_PORT=8203
# WEB_SEARCH_VERIFIER_TOKEN=
WEB_SEARCH_VERIFIER_TIMEOUT_SECONDS=120
# networks to search (default: this machine's network, e.g. 192.168.1.0/24). In Docker: set it to your LAN
# WEB_SEARCH_DISCOVERY_SUBNETS=192.168.1.0/24
# Saved runs for the "Retry" button (POST /custom/retry: re-sends question + top 3, no search / LLM); default: logs/checkpoints
# WEB_SEARCH_CHECKPOINT_DIR=

# ------------------------------------------------------------------ page fetching
WEB_SEARCH_MAX_PAGES_TO_FETCH=4
WEB_SEARCH_PAGE_DEADLINE_SECONDS=8
WEB_SEARCH_RESPECT_ROBOTS_TXT=true
WEB_SEARCH_USE_PLAYWRIGHT_FALLBACK=false

# ------------------------------------------------------------------ reranker
# Downloaded once into backend/web_search_agent/models/ and loaded from there (no download on every start).
# cross-encoder/ms-marco-MiniLM-L-6-v2  90 MB, fast on CPU (default) | BAAI/bge-reranker-base  1.1 GB, ~4x slower
# BAAI/bge-reranker-v2-m3  multilingual, best with a GPU
WEB_SEARCH_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
WEB_SEARCH_RECENCY_WEIGHT=0.1
# boost for trusted sources (0-1)
WEB_SEARCH_TRUSTED_BOOST=0.15
