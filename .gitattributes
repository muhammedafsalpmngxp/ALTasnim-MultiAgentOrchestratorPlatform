# Normalize line endings: LF in the repository and working tree (Docker images and CI run on Linux).
* text=auto eol=lf

*.ps1 text eol=crlf
*.bat text eol=crlf

*.png binary
*.jpg binary
*.ico binary
*.woff binary
*.woff2 binary
*.gif binary
*.pdf binary
*.docx binary
*.xlsx binary
*.onnx binary
*.safetensors binary
*.bin binary
*.sh text eol=lf
